 "commands": {
  "note": "Run from the repository root. W is a scratch directory. On the Spark the repository is copied by rsync (without .git) to ~/metal-tests/lot01s-t1, Node 24 comes from nvm, TMPDIR is under ~/metal-tests, CC=gcc and CHROME=/usr/bin/google-chrome; on the Mac CC=clang and CHROME is Google Chrome.app. O is mac/ or spark/.",
  "measurements": [
   "node tools/platform-math.mjs golden . --out $O/golden.json",
   "node tools/platform-math.mjs census . --out $O/census.json",
   "node tools/platform-math.mjs checkpoints . --out $O/checkpoints.json",
   "node tools/platform-math.mjs replay . --out $O/replay-native.json",
   "node tools/platform-math.mjs replay . --fmath --out $O/replay-fmath.json",
   "node tools/platform-math.mjs replay . --scenario campaign2-w1,campaign2-w10 --steps 120 --out $O/replay-v2-native.json",
   "node tools/platform-math.mjs replay . --fmath --scenario campaign2-w1,campaign2-w10 --steps 120 --out $O/replay-v2-fmath.json",
   "node tools/platform-math.mjs engines . --dir $W/eng --census $O/census.json --chrome $CHROME --out $O/engines.json",
   "node docs/chantier-moteur/preuves/lot-01s/t1/gen-vectors.mjs vectors --cc $CC --work $W/vec --report $O/vectors-$CC.json",
   "node docs/chantier-moteur/preuves/lot-01s/t1/gen-vectors.mjs exhaustive --cc $CC --path fmath --work $W/ex --report $O/exhaustive-fmath.json",
   "node docs/chantier-moteur/preuves/lot-01s/t1/gen-vectors.mjs exhaustive --cc $CC --path host --work $W/ex --report $O/exhaustive-host.json",
   "node docs/chantier-moteur/preuves/lot-01s/t1/gen-vectors.mjs sweep --cc $CC --work $W/sw --report $O/sweep.json",
   "node docs/chantier-moteur/preuves/lot-01s/t1/branch-coverage.mjs > $O/branch-coverage.json",
   "node docs/chantier-moteur/preuves/lot-01s/t1/mutation-check.mjs $W/mut > $O/mutation-check.json",
   "node docs/chantier-moteur/preuves/lot-01s/t1/profiles-check.mjs --work $W/prof --out $O/profiles.json",
   "node docs/chantier-moteur/preuves/lot-01s/t1/summarize.mjs env --cc $CC --chrome $CHROME --out $O/environment.json"
  ],
  "tests": {
   "mac": "npm test > npm-test.log 2>&1 (local, Node 24.18 darwin-arm64)",
   "spark": "~/claude/metal-chantier/outils/npm-test-spark.sh <repository> <log> (rsync to the Spark, npm test with Node 24.18 linux-arm64)"
  },
